# Copy to .env for local runs, or set the same vars in your MCP client config.
# Nothing here is required as a set; only providers with a key become active.

# ---------------------------------------------------------------------------
# API keys — set any subset. Each one enables that provider.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# GEMINI_API_KEY=...              # GOOGLE_API_KEY also works
# XAI_API_KEY=xai-...
# TOGETHER_API_KEY=...
# DEEPINFRA_API_KEY=...
# SILICONFLOW_API_KEY=...
# FIREWORKS_API_KEY=...

# Any other OpenAI-compatible endpoint (LM Studio, vLLM, ComfyUI gateway, ...).
# IMAGE_MCP_BASE_URL=http://localhost:8000/v1
# IMAGE_MCP_API_KEY=not-needed
# IMAGE_MCP_MODEL=my-model-id

# Override the built-in OpenAI base URL to point at a compatible proxy.
# OPENAI_BASE_URL=https://my-proxy.example/v1

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------
# Where generated images are written when output_path is not given.
# Default: the workspace / current directory, so images land next to the
# project being worked on. Set this only to force a fixed folder.
# OUTPUT_DIR=./generated

# Per-request timeout in seconds (image generation can take minutes).
# IMAGE_MCP_TIMEOUT=300

# Retry attempts for 429/5xx and network errors.
# IMAGE_MCP_RETRIES=3

# How long discovered model lists are cached, in seconds (default 1 day).
# IMAGE_MCP_MODEL_TTL=86400

# Extra config file (providers, aliases, defaults).
# IMAGE_MCP_CONFIG=./providers.json

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
